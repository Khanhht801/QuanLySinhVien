  <property name="styleSheet">
   <string>QMainWindow, QWidget#centralwidget { background: #f6f8fb; color: #121820; }
QWidget { font-family: "Segoe UI"; }
QFrame#header { border-image: url(:/icons/header.svg) 0 0 0 0 stretch stretch; }
QLabel#titleLabel, QLabel#subtitleLabel { color: white; background: transparent; }
QTabWidget::pane { border: 1px solid #b5c0ce; border-left: 0; border-right: 0; border-bottom: 0; top: -1px; background: #f8fafc; }
QTabWidget::tab-bar { left: 16px; }
QTabBar::tab { color: #151b23; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #edf1f6,stop:1 #e4eaf0); border: 1px solid #bbc6d3; border-top-left-radius: 7px; border-top-right-radius: 7px; padding: 9px 14px; margin-top: 8px; min-height: 18px; }
QTabBar::tab:selected { background: #fafcfe; border-bottom-color: #fafcfe; font-weight: bold; }
QTabBar::tab:hover { background: #eef6ff; }
QFrame#studentCard, QFrame#subjectCard { background: #f1f5f9; border: 1px solid #d6e0ec; border-radius: 7px; }
QLabel#studentHeading, QLabel#subjectHeading { background: #d1e5f9; color: #0056b7; border: none; border-top-left-radius: 6px; border-top-right-radius: 6px; padding: 4px 12px; font-weight: bold; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #ffffff; color: #111820; border: 1px solid #aebccc; border-radius: 5px; padding: 3px 8px; selection-background-color: #bde1ff; selection-color: #101820; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #1683d5; }
QLineEdit { min-width: 40px; }
QComboBox { padding-right: 30px; }
QComboBox::drop-down { border: none; width: 30px; }
QComboBox::down-arrow { image: url(:/icons/chevron.svg); width: 14px; height: 14px; }
QSpinBox, QDoubleSpinBox { padding-right: 30px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 27px; border-left: 1px solid #eef1f5; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 27px; border-left: 1px solid #eef1f5; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/icons/up.svg); width: 12px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/icons/down.svg); width: 12px; height: 10px; }
QLabel#totalScoreLabel { background: #cef0d5; border-radius: 6px; color: #101c16; font-weight: bold; }
QFrame#searchBar { background: #f0f3f7; border-radius: 7px; }
QTableWidget { background: #fff; alternate-background-color: #fafbfd; border: 1px solid #a8b5c5; border-radius: 5px; gridline-color: #d5dce5; selection-background-color: #c6e7ff; selection-color: #101820; outline: 0; }
QTableWidget#studentsTable::item { padding: 6px 8px; border: none; }
QHeaderView::section { background: #f5f7fa; color: #111820; border: none; border-right: 1px solid #c1cbd7; border-bottom: 1px solid #c1cbd7; padding: 7px 4px; font-weight: bold; }
QTableCornerButton::section { background: #f5f7fa; border: none; }
QPushButton { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #f0f3f7); border: 1px solid #aab7c8; border-radius: 6px; padding: 5px 10px; color: #111820; }
QPushButton:hover { border-color: #1683d5; background: #eaf4ff; }
QPushButton:pressed { background: #d7eaff; }
QPushButton#addButton { background: #25bc43; border-color: #1aa335; color: white; }
QPushButton#addButton:hover { background: #20a93b; }
QPushButton#editButton { color: #626e7a; }
QPushButton#deleteButton { border-color: #fa4147; color: #ec2028; background: #ffffff; }
QPushButton#deleteButton:hover { background: #fff0f1; }
QFrame#sidebarDivider { color: #e1e6ee; }

QScrollArea#sidebarScroll, QWidget#sidebar, QWidget#sidebarColumn { background: transparent; }
/* Semester overview */
QWidget#summaryContent, QWidget#summaryBottom, QScrollArea#summaryScroll { background: #f8fafc; }
QFrame#summaryGradesCard, QFrame#subjectsCard, QFrame#statisticsCard, QFrame#summaryActionsCard {
 background: #ffffff; border: 1px solid #cbdced; border-radius: 7px;
}
QFrame#summaryToolbar, QFrame#subjectsCardHeader, QFrame#statisticsCardHeader, QFrame#summaryActionsCardHeader {
 background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #d7eaff,stop:1 #c9e0fc);
 border: none; border-top-left-radius: 7px; border-top-right-radius: 7px;
}
QLabel#summaryHeading, QLabel#subjectsCardTitle, QLabel#statisticsCardTitle, QLabel#summaryActionsCardTitle { color: #004cce; }
QTableWidget#summaryTable, QTableWidget#subjectsTable { border: 1px solid #c0d0e3; gridline-color: #c7d1df; border-radius: 5px; alternate-background-color: #fafcff; }
QTableWidget#summaryTable QHeaderView::section, QTableWidget#subjectsTable QHeaderView::section {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #d7eaff,stop:1 #c7e0fa);
 border-right: 1px solid #a9c8ed; border-bottom: 1px solid #b7cce5; padding: 5px 3px;
}
QFrame#totalStudentsCard { background: #e0fbd9; border: none; border-radius: 7px; }
QPushButton#summarySearchButton { background: #0079e8; border-color: #0069ce; color: white; padding: 4px 12px; }
QPushButton#summarySearchButton:hover { background: #0069cd; }
QPushButton#summaryRefreshButton { background: #eff6ff; border-color: #71aaff; color: #064fdf; padding: 6px 9px; }
QPushButton#summaryRefreshButton:hover { background: #dcecff; }
QPushButton#summaryExportButton { background: #effded; border-color: #47ae50; color: #078421; padding: 6px 9px; }
QPushButton#summaryExportButton:hover { background: #dbf6d6; }
</string>
