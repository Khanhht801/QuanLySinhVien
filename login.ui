QLineEdit { background: white; border: 1px solid #b9c8da; border-radius: 6px; padding: 9px 12px; selection-background-color: #c6e7ff; }
QLineEdit:focus { border: 1px solid #1683d5; }
QPushButton { background: white; border: 1px solid #b9c8da; border-radius: 6px; padding: 10px 16px; }
QPushButton:hover { background: #eaf4ff; border-color: #1683d5; }
QPushButton#loginButton { background: #0079e8; border-color: #0069ce; color: white; font-weight: bold; }
QPushButton#loginButton:hover { background: #0069cd; }
QPushButton#loginButton:pressed { background: #0058ad; }</string>
